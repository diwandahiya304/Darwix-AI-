# Secrets / environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Data & recordings — likely to contain real customer data / PII.
# Never committed by default. Force-add a specific file only after
# confirming it is synthetic/sample data with no PII (see CLAUDE.md §2).
/data/raw/*
!/data/raw/.gitkeep

/recordings/**
!/recordings/**/
!/recordings/**/.gitkeep
# Markdown transcripts are text, reviewable at a glance, and in this repo
# are only ever generated by voice_agent/sim/chat_sim.py from synthetic
# scripted scenarios (never a real call) — tracked by exception. This
# does NOT extend to audio files or scripts/pull_transcripts.py's real
# Vapi call data (currently .json) — apply the same synthetic-data
# confirmation as data/raw/ (CLAUDE.md §2) before committing any of that.
!/recordings/**/*.md

# kb/ retrieval index — a reproducible binary build artifact derived from
# data/processed/kb_records.jsonl (rebuild with `make kb-index`), not
# source data. Keeping it out of git avoids committing a Chroma/Qdrant
# binary blob that would just drift from the flat file anyway.
/data/processed/kb_index/

# voice_agent/ mock CRM + escalation log — regeneratable demo artifacts
# from `make voice-agent-sim` runs (synthetic test data only), same
# reasoning as kb_index/ above: reproducible, not source data.
/data/processed/mock_crm*.sqlite3
/data/processed/escalations.jsonl

# live_nudges/ per-call latency JSONL logs — regenerated by every
# `make q4-report`/`make q4-quality` run (or any replay); the aggregated,
# checked-in result is docs/q4_live_nudges/latency_report.{md,json}, not
# these raw per-hop logs.
/data/processed/live_nudges_latency/

# Local scratch / overrides
*.local
