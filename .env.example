# Copy this file to .env and fill in real values. Never commit .env itself.
# Every env var used anywhere in the repo must have a placeholder here
# (CLAUDE.md §2) — keep this file in sync as components are implemented.

# --- App-wide ---------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- LLM provider (used by voice_agent/sim/chat_sim.py --mode llm; kb/'s
# retrieval doesn't need one — it's a local embedding model) -------------
# Only "anthropic" is implemented in code (sim/chat_sim.py) — see
# docs/DECISIONS.md for why OpenAI support was scoped out. Leave
# LLM_API_KEY as "changeme" to run the simulator in --mode scripted
# (no key needed) instead of --mode llm.
LLM_PROVIDER=anthropic
LLM_API_KEY=changeme
LLM_MODEL=claude-haiku-4-5-20251001

# --- Embeddings + vector store (kb/) -----------------------------------
# Local model, no API key needed — direct transformers+torch (not the
# sentence-transformers wrapper; see docs/DECISIONS.md), mean-pooled +
# L2-normalized per the E5 model card's "query: "/"passage: " convention.
# Multilingual so the same model also serves Q3 (Philippines/Indonesia).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
HF_HUB_OFFLINE=1                    # skip HF Hub's online freshness check once the model is cached locally
VECTOR_STORE_BACKEND=chroma         # chroma | qdrant — both run fully local, no server needed
VECTOR_STORE_PATH=./data/processed/kb_index

# --- KB retrieval API (kb/) ---------------------------------------------
KB_API_BASE_URL=http://localhost:8001
KB_PORT=8001
KB_TOP_K=3
KB_SEARCH_TOP_K=3                   # voice_agent/ and multilingual/'s own top_k setting when calling kb/'s /search (distinct from KB_TOP_K, which is kb/'s own default)
KB_MIN_RELEVANCE_SCORE=0.84         # calibrated empirically against kb/eval/queries.yaml — see docs/DECISIONS.md; below this, voice agent must fall back — never invent
KB_MIN_RELEVANCE_SCORE_FIL=0.822    # per-language override for Q3 Philippines (Filipino/Taglish) — see docs/DECISIONS.md for why the global threshold was too high for non-English content
KB_MIN_RELEVANCE_SCORE_ID=0.828     # per-language override for Q3 Indonesia (Bahasa Indonesia) — same reason

# --- Voice platform: Vapi (voice_agent/) ---------------------------------
# All optional: voice_agent/app/main.py (the webhook server), scoring,
# escalation, and the mock CRM all work and are fully tested without
# these set. Only scripts/create_assistant.py and
# scripts/pull_transcripts.py need a real VAPI_API_KEY — see
# voice_agent/README.md "Vapi Setup Steps" for getting one and exposing
# the webhook publicly (ngrok/cloudflared).
VAPI_API_KEY=changeme
VAPI_ASSISTANT_ID=changeme          # set after scripts/create_assistant.py succeeds
VAPI_PHONE_NUMBER_ID=changeme       # optional — only if using a real inbound/outbound number, not web calling only
WEBHOOK_BASE_URL=changeme           # public ngrok/cloudflared URL pointing at voice_agent's /webhook
VOICE_AGENT_PORT=8002

# --- Multilingual voice bots: Philippines + Indonesia (multilingual/) ----
# Same Vapi account/API key as voice_agent/ (VAPI_API_KEY above). Each
# market has its own webhook base URL/port since they run as separate
# FastAPI apps — see multilingual/README.md "Vapi Setup Steps". Neither
# is exercised live in this environment.
PH_WEBHOOK_BASE_URL=changeme        # public ngrok/cloudflared URL pointing at the Philippines webhook
PH_PORT=8003
PH_VAPI_ASSISTANT_ID=changeme        # set after multilingual-create-assistant-ph succeeds
ID_WEBHOOK_BASE_URL=changeme        # public ngrok/cloudflared URL pointing at the Indonesia webhook
ID_PORT=8004
ID_VAPI_ASSISTANT_ID=changeme        # set after multilingual-create-assistant-id succeeds

# --- ASR (speech-to-text) — multilingual/asr_bench/ candidate providers -
# Not live in this environment (see docs/q3_multilingual/asr_report.md's
# "Read this first"). Only needed to run a real (non-illustrative) ASR
# benchmark for Q3. Q4's live_nudges/ ASR is real and local
# (faster-whisper, configured separately below) — it does not use these.
DEEPGRAM_API_KEY=changeme
AZURE_SPEECH_KEY=changeme
AZURE_SPEECH_REGION=changeme

# --- Live nudges (live_nudges/) ------------------------------------------
# CLI (make q4-sim) and the WebSocket dashboard (make q4-demo /
# make run-live-nudges) are the delivery channels. ASR is real and local
# (faster-whisper) — no ASR_PROVIDER/ASR_API_KEY needed for live_nudges/
# specifically (those vars above are multilingual/'s). The LLM signal
# layer reuses LLM_API_KEY/LLM_MODEL above (same Anthropic account as
# voice_agent/) — leave LLM_API_KEY as "changeme" to run with only the
# fast rule-based signal layer (fully functional on its own).
CHUNK_MS=300
ASR_WINDOW_MS=2000
ASR_PARTIAL_MS=1000
ASR_MODEL=tiny.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_SAMPLE_RATE=16000
LLM_WINDOW_SECONDS=30
LLM_MIN_INTERVAL_SECONDS=5
NUDGE_CONFIDENCE_THRESHOLD=0.6
NUDGE_COOLDOWN_SECONDS=30
NUDGE_EXPIRY_SECONDS=60
NUDGE_SEMANTIC_DUP_THRESHOLD=0.90
LIVE_NUDGES_PORT=8005
# Compliance content config (app/disclosure.py) — repo-relative by
# default, only override if moving these files.
DISCLOSURES_CONFIG_PATH=live_nudges/config/disclosures.yaml
APPROVED_OFFERS_CONFIG_PATH=live_nudges/config/approved_offers.yaml

# --- Business actions (voice_agent/) --------------------------------------
# escalate_to_human: posts here if configured; otherwise logs a "would
# transfer to <number>" entry for demo purposes (see app/escalation.py —
# there is no real telephony transfer capability without a live Vapi call).
ESCALATION_WEBHOOK_URL=changeme
ESCALATION_TRANSFER_NUMBER=changeme
# create_lead / schedule_callback: mock CRM, stdlib sqlite3, no new dependency.
CRM_DB_PATH=./data/processed/mock_crm.sqlite3
